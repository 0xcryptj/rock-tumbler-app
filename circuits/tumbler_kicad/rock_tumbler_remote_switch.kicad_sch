  (text "1. Build as a switched extension cord/outlet box, not inside the tumbler." (at 28.00 265.00 0)
    (effects (font (size 1.50 1.50)) (justify left))
    (uuid "8ba04393-86af-41c0-86c1-1f4ea2f5f787"))
  (text "2. Use NO contact so loss of ESP32 power fails OFF." (at 28.00 273.00 0)
    (effects (font (size 1.50 1.50)) (justify left))
    (uuid "563b88dc-0fe6-458c-8bc3-580e4af1e6f8"))
  (text "3. Switch HOT only. Never break ground. Neutral passes through." (at 28.00 281.00 0)
    (effects (font (size 1.50 1.50)) (justify left))
    (uuid "31ec6a1f-858f-41ce-8e92-43b5bdf38b3c"))
  (text "4. Put a GFCI upstream and use strain relief/cable glands." (at 28.00 289.00 0)
    (effects (font (size 1.50 1.50)) (justify left))
    (uuid "e3d0d0b2-f0dd-4533-b58e-7789d36d5a55"))
  (text "5. Keep AC wires and ESP32 jumper wires separated inside enclosure." (at 28.00 297.00 0)
    (effects (font (size 1.50 1.50)) (justify left))
    (uuid "fda1b367-833a-413f-b44a-42966f9bb62a"))
