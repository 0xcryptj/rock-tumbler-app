# gateway/.env — Cloudflare Tunnel deployment template
# Copy to gateway/.env on the home machine, then fill in the placeholders.
# Camera RTSP, ESP32, and go2rtc stay on the home LAN. ONLY this Express
# gateway is exposed publicly, and only through a Cloudflare Tunnel.

# --- Listener ---------------------------------------------------------------
PORT=8080

# --- Public URL (Cloudflare Tunnel hostname) --------------------------------
# Matches the hostname configured in cloudflared (see docs/cloudflared-config.example.yml).
# The gateway uses this to build absolute stream / playback URLs for the app.
PUBLIC_BASE_URL=https://tumbler.YOURDOMAIN.com

# Extra hostnames whose Host header should be trusted as "public". The
# PUBLIC_BASE_URL host is already trusted; only add more if you also expose
# this gateway through Tailscale Funnel, a second domain, etc.
ALLOWED_PUBLIC_HOSTS=tumbler.YOURDOMAIN.com

# --- Local-only client URLs (optional, used by /health + diagnostics) -------
LOCAL_API_URL=http://192.0.2.30:8080
REMOTE_API_URL=
TAILSCALE_HOSTNAME=
TAILSCALE_IP=

# --- Authentication ---------------------------------------------------------
# Cloudflare Access (Zero Trust) is the primary auth layer — restrict the
# tumbler.YOURDOMAIN.com application to your dad's email / Google identity.
#
# API_KEY is a secondary defense in depth check inside the gateway. Set a
# strong random value AND set EXPO_PUBLIC_API_KEY in tumbler-remote/.env to
# match (the value gets baked into the web bundle, so it is not a secret
# from the browser — Cloudflare Access is the real gate).
REQUIRE_API_KEY=true
API_KEY=REPLACE_WITH_64_HEX_CHARS

# --- go2rtc (localhost only — never expose to WAN) --------------------------
GO2RTC_BASE=http://127.0.0.1:1984
GO2RTC_STREAM=tumbler_cam

# --- Camera (LAN only — never reachable through the tunnel) -----------------
CAMERA_TYPE=tapo
CAMERA_IP=192.0.2.50
RTSP_PATH=stream1
RTSP_USER=REPLACE_RTSP_USER
RTSP_PASS=REPLACE_RTSP_PASS
RTSP_URL=rtsp://REPLACE_RTSP_USER:REPLACE_RTSP_PASS@192.0.2.50:554/stream1
RTSP_USE_FFMPEG=true
GO2RTC_AUDIO=aac

# --- ESP32 relay (LAN only) -------------------------------------------------
ESP32_BASE=http://192.0.2.100
ESP32_DEVICE_ID=tumbler-01
ESP32_EXPECTED_RELAY_PIN=5
ESP32_RELAY_INVERT=false

# --- Stream session lifetime ------------------------------------------------
STREAM_SESSION_MINUTES=30
DEFAULT_STREAM_PROTOCOL=mse

# --- Optional: serve a pre-built Expo web bundle from a custom path ---------
# WEB_DIST_DIR=/srv/rock-tumbler-app/tumbler-remote/dist
