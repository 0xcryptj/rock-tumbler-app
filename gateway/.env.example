# Copy to gateway/.env — set PUBLIC_BASE_URL to your PC LAN IP (ipconfig IPv4)

PORT=8080
PUBLIC_BASE_URL=http://10.0.0.30:8080

GO2RTC_BASE=http://127.0.0.1:1984
GO2RTC_STREAM=tumbler_cam

# tapo | eufy | reolink | wyze | generic | auto (infers from RTSP path)
CAMERA_TYPE=tapo

CAMERA_IP=10.0.0.50
RTSP_PATH=stream1
RTSP_USER=your_rtsp_username
RTSP_PASS=your_rtsp_password
RTSP_URL=rtsp://your_rtsp_username:your_rtsp_password@10.0.0.50:554/stream1
# Tapo: true. Eufy Digest: false. See docs/CAMERA-PROFILES.md
RTSP_USE_FFMPEG=true
GO2RTC_AUDIO=aac

ESP32_BASE=http://10.0.0.100
ESP32_DEVICE_ID=tumbler-01
ESP32_EXPECTED_RELAY_PIN=5
# true = swap start/stop when relay polarity is opposite the sketch (no reflash)
ESP32_RELAY_INVERT=false

STREAM_SESSION_MINUTES=30
DEFAULT_STREAM_PROTOCOL=mse
API_KEY=
