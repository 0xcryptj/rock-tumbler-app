# Copy this file to gateway/.env and replace every REPLACE_* / 192.0.2.* value
# with your real values. The 192.0.2.x range is the RFC 5737 documentation
# block — it never routes, so you'll know nothing is wired up until you swap
# it for your actual LAN IPs.
#
# Camera + ESP32 stay on home LAN. Only this gateway host runs Tailscale.
# Quickest path: run `npm run sync:lan` from the repo root after copying.

PORT=8080

# --- Client-facing URLs (phones connect to gateway only) ---
# LOCAL_API_URL  = your home WiFi LAN URL (auto-filled by `npm run sync:lan`)
LOCAL_API_URL=http://192.0.2.30:8080
# REMOTE_API_URL = Tailscale URL (auto-filled by `npm run sync:tailscale`)
REMOTE_API_URL=
# PUBLIC_BASE_URL = optional fixed URL for stream playback links.
# Leave empty to auto-match the client Host header (works for both
# LAN and Tailscale/Funnel access without restarting).
PUBLIC_BASE_URL=

# Tailscale MagicDNS hostname + IP (auto-filled by `npm run sync:tailscale`)
TAILSCALE_HOSTNAME=
TAILSCALE_IP=

# --- Authentication ---
# Strong random API key — REQUIRED once Tailscale is up
# (REQUIRE_API_KEY auto-enables when the gateway detects tailscaled).
# Generate one with:    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then mirror the SAME value into tumbler-remote/.env as EXPO_PUBLIC_API_KEY.
API_KEY=REPLACE_WITH_64_HEX_CHARS
# Force API key on/off: true | false (default: true when Tailscale detected)
REQUIRE_API_KEY=

# go2rtc stays on localhost — never expose to WAN
GO2RTC_BASE=http://127.0.0.1:1984
GO2RTC_STREAM=tumbler_cam

# tapo | eufy | reolink | wyze | generic | auto (infers from RTSP path)
CAMERA_TYPE=tapo

# Camera on home LAN only (gateway reads RTSP; phone never sees these)
CAMERA_IP=192.0.2.50
RTSP_PATH=stream1
RTSP_USER=REPLACE_RTSP_USER
RTSP_PASS=REPLACE_RTSP_PASS
RTSP_URL=rtsp://REPLACE_RTSP_USER:REPLACE_RTSP_PASS@192.0.2.50:554/stream1
RTSP_USE_FFMPEG=true
GO2RTC_AUDIO=aac

# ESP32 on home LAN only (gateway proxies; phone never calls ESP32 directly)
ESP32_BASE=http://192.0.2.100
ESP32_DEVICE_ID=tumbler-01
ESP32_EXPECTED_RELAY_PIN=5
ESP32_RELAY_INVERT=false

# Stream session token lifetime (minutes) — use 15–30 for remote access
STREAM_SESSION_MINUTES=30
DEFAULT_STREAM_PROTOCOL=mse
