# Copy to tumbler-remote/.env
# App connects ONLY to the gateway — never to camera RTSP or ESP32 directly.

# ---------------------------------------------------------------------------
# Dev (LAN / Tailscale) — Expo runs at :8081, gateway at :8080
# Replace the example IP with your LAN IPv4 or run `npm run sync:lan`.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_LOCAL_API_URL=http://192.0.2.30:8080
# Tailscale remote URL (npm run sync:tailscale on gateway PC)
EXPO_PUBLIC_REMOTE_API_URL=
# Fallback if only one URL is configured
EXPO_PUBLIC_API_BASE_URL=http://192.0.2.30:8080

EXPO_PUBLIC_DEVICE_ID=tumbler-01
# Must match gateway API_KEY when using Tailscale remote access
EXPO_PUBLIC_API_KEY=

# ---------------------------------------------------------------------------
# Production (Cloudflare Tunnel) — gateway serves the Expo web build itself.
# Leave all three URLs unset so the app uses `window.location.origin`, i.e.
# https://tumbler.YOURDOMAIN.com → same-origin /api/* calls. Or set explicitly:
#
#   EXPO_PUBLIC_API_BASE_URL=https://tumbler.YOURDOMAIN.com
#
# See docs/CLOUDFLARE_REMOTE_ACCESS.md for the full deployment guide.
# ---------------------------------------------------------------------------

# App UI (dev):  http://<gateway-host>:8081
# API (gateway): http://<gateway-host>:8080
# Prod (Cloudflare): https://tumbler.YOURDOMAIN.com (gateway serves UI + API)
