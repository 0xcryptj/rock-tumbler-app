#pragma once

// Copy this file to config.h and fill in your values before flashing.

#define WIFI_SSID "YourWiFiName"
#define WIFI_PASSWORD "YourWiFiPassword"

// Must match Device ID in the Tumbler Remote app settings.
#define DEVICE_ID "tumbler-01"

// Optional: set to a non-empty string to require Authorization: Bearer <key>
// Leave empty ("") for open LAN testing only.
#define API_KEY ""

// GPIO connected to relay IN (project wiring: GPIO26).
#define RELAY_PIN 26

// HIGH = relay energized (motor on). Set false if your module is active-low.
#define RELAY_ON_LEVEL HIGH
#define RELAY_OFF_LEVEL LOW
